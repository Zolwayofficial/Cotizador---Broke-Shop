# === Cotizador de Importación Perú v2.0 — Configuración ===

# Puerto del servidor
PORT=3000

# IA — API Keys (server-side, NUNCA en frontend)
GROQ_API_KEY=gsk_xxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# Modelo Groq sin límite diario (último fallback, nunca falla)
# Cambia este valor si Groq agrega nuevos modelos ilimitados
GROQ_MODEL_UNLIMITED=llama-3.1-8b-instant

# Auth
JWT_SECRET=cambiar-a-algo-seguro-y-aleatorio

# Tracking (opcional — gratis hasta 100/día en 17track.net)
TRACK17_API_KEY=

# Base de datos
DB_PATH=./data/cotizador.db
DATA_DIR=./data

# NANDINA auto-update (5 tablas de Aduanet)
NANDINA_UPDATE_CRON=0 3 * * 1

# Dominio (para CORS y SSL)
DOMAIN=cotizador.tudominio.com

# Node environment
NODE_ENV=production
