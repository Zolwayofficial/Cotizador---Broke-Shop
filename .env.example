# === ImportAIAgent Cotizador - configuracion de ejemplo ===
# Documentacion base: README.md

# ==================================================
# SERVIDOR
# ==================================================
PORT=3000
WS_PORT=3002
NODE_ENV=production

# ==================================================
# IA
# ==================================================
# Opcion A: Groq Cloud
GROQ_API_KEY=gsk_xxxxxxxxxxxxx
GROQ_MODEL_UNLIMITED=llama-3.1-8b-instant
GROQ_MODEL_CHAT_CHAIN=openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_MODEL_DASHBOARD_CHAIN=openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_MODEL_SQL_CHAIN=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_MODEL_EXTRACT_CHAIN=llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct

# Opcion B: OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# Opcion C: modelos locales
# AI_ENDPOINT=http://localhost:11434/v1
# AI_MODEL_CLASSIFY=llama3.3:70b
# AI_MODEL_EXTRACT=llama3.2-vision:11b

# Tipo de cambio oficial resistente (opcional)
# Activalo solo si instalaste el modulo Python/browser correspondiente.
OFFICIAL_FX_STEALTH_ENABLED=false
OFFICIAL_FX_STEALTH_TIMEOUT_MS=8000
OFFICIAL_FX_STEALTH_HEADLESS=true
OFFICIAL_FX_USE_CAMOUFOX=false
OFFICIAL_FX_BROWSER_CHANNEL=chrome
# OFFICIAL_FX_PYTHON_BIN=python3
# OFFICIAL_FX_CACHE_TTL_MS=900000

# OCR oficial opcional
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_PROVIDER=google_documentai
DOCUMENT_OCR_TIMEOUT_MS=15000
DOCUMENT_OCR_MIN_TEXT_LENGTH=40
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/segura/google-adc.json

# ==================================================
# SEGURIDAD
# ==================================================
JWT_SECRET=cambiar-a-algo-seguro-y-aleatorio-min-32-chars
JWT_TTL_DAYS=7

# ==================================================
# CORS
# ==================================================
DOMAIN=cotizador.tudominio.com
# ALLOWED_ORIGINS=https://cotizador.tudominio.com,https://www.otro-dominio.com

# ==================================================
# BASE DE DATOS
# ==================================================
DB_PATH=./data/cotizador.db
DATA_DIR=./data

# ==================================================
# NANDINA
# ==================================================
NANDINA_UPDATE_CRON=0 3 * * 1

# ==================================================
# TRACKING
# ==================================================
TRACK17_API_KEY=

# ==================================================
# FLETES
# ==================================================
TRACKINGMORE_API_KEY=
SEARATES_API_KEY=

# ==================================================
# BACKUPS
# ==================================================
BACKUP_CRON=0 4 * * *
BACKUP_RETENTION_DAYS=30

# ==================================================
# NOTIFICACIONES OPCIONALES
# ==================================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=
