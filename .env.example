# === Cotizador de Importación Perú v2.0 — Configuración ===
# Documentación completa: README.md

# ══════════════════════════════════════════════════
# SERVIDOR
# ══════════════════════════════════════════════════
PORT=3000
NODE_ENV=production

# ══════════════════════════════════════════════════# IA — CONFIGURACIÓN
# ══════════════════════════════════════════════════
# Opción A: Groq Cloud (gratis con límites)
GROQ_API_KEY=gsk_xxxxxxxxxxxxx
GROQ_MODEL_UNLIMITED=llama-3.1-8b-instant

# Opción B: OpenAI (pago)
OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# Opción C: Modelos locales (Ollama/vLLM) — RECOMENDADO para producción
# AI_ENDPOINT=http://localhost:11434/v1
# AI_MODEL_CLASSIFY=llama3.3:70b
# AI_MODEL_EXTRACT=llama3.2-vision:11b

# ══════════════════════════════════════════════════
# SEGURIDAD
# ══════════════════════════════════════════════════
# IMPORTANTE: En producción, usar variable de entorno del sistema
# Ejemplo: export JWT_SECRET="tu-secret-aqui" en el VPS
JWT_SECRET=cambiar-a-algo-seguro-y-aleatorio-min-32-chars

# Tiempo de vida del token (días)
JWT_TTL_DAYS=7

# ══════════════════════════════════════════════════
# CORS — Lista blanca de orígenes permitidos
# ══════════════════════════════════════════════════
# Para múltiples dominios: https://dominio1.com,https://dominio2.com
DOMAIN=cotizador.tudominio.com
# ALLOWED_ORIGINS=https://cotizador.tudominio.com,https://www.otro-dominio.com

# ══════════════════════════════════════════════════
# BASE DE DATOS
# ══════════════════════════════════════════════════
DB_PATH=./data/cotizador.db
DATA_DIR=./data

# ══════════════════════════════════════════════════
# NANDINA — Auto-actualización
# ══════════════════════════════════════════════════
# Cron schedule: minuto hora día mes día-semana
# Default: Todos los lunes a las 3:00 AM
NANDINA_UPDATE_CRON=0 3 * * 1

# ══════════════════════════════════════════════════
# TRACKING — 17track API (opcional)
# ══════════════════════════════════════════════════
# Gratis hasta 100 consultas/día en 17track.net
TRACK17_API_KEY=

# ══════════════════════════════════════════════════
# FLETES — APIs opcionales (mejora cotizaciones)
# ══════════════════════════════════════════════════
# TrackingMore API (gratis 100/day) — https://www.trackingmore.com/api
TRACKINGMORE_API_KEY=

# Searates API (requiere registro) — https://www.searates.com/
SEARATES_API_KEY=

# Si NO se configuran las APIs, se usan tarifas referenciales hardcoded

# ══════════════════════════════════════════════════
# LOGGING Y MONITOREO (opcional)
# ══════════════════════════════════════════════════
# LOG_LEVEL=info  # debug, info, warn, error
# LOG_FILE=./data/cotizador.log

# ══════════════════════════════════════════════════
# BACKUP AUTOMÁTICO
# ══════════════════════════════════════════════════
# Backup CRON schedule (default: diario 4 AM)
BACKUP_CRON=0 4 * * *
# Días de retención de backups
BACKUP_RETENTION_DAYS=30

# ══════════════════════════════════════════════════
# NOTIFICACIONES (opcional — para alertas de CRON)
# ══════════════════════════════════════════════════
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=
