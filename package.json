{
  "name": "cotizador-peru-ultimate",
  "version": "3.0.0",
  "description": "Cotizador de Importación Perú - Ultimate v3.0",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --open",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --coverage",
    "test:e2e": "jest tests/e2e --coverage",
    "lint": "eslint server/**/*.js",
    "lint:fix": "eslint server/**/*.js --fix",
    "production:check": "node scripts/validate-production-env.js",
    "cleanup:weekly": "node scripts/weekly-cleanup.js",
    "backup:secure": "node scripts/create-secure-backup.js",
    "backup:restore": "node scripts/restore-secure-backup.js",
    "docs": "jsdoc -c jsdoc.json -r server -d docs/api",
    "client:install": "cd client && npm install",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "warmup": "node -e \"require('./server/embeddings').precalentarModelo()\"",
    "update-nandina": "node scripts/update-nandina.js",
    "setup": "bash scripts/setup.sh",
    "build-client": "cd client && npm run build"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.0",
    "axios": "^1.6.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "groq-sdk": "^0.3.2",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.2",
    "open": "^11.0.0",
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.10.3",
    "ws": "^8.14.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "gulp-header": "^2.0.12",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.2",
    "lodash.template": "^4.5.0",
    "markdown-toc": "^1.2.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "server/**/*.js",
      "!server/index.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "importacion",
    "peru",
    "sunat",
    "aduanas",
    "cotizador",
    "logistica",
    "ia",
    "dashboard"
  ],
  "author": "Chinito Cochino",
  "license": "MIT"
}
